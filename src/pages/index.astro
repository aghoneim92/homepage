---
import ProjectCard from '../components/ProjectCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { settings } from '../config';
import { contact, jobs, sideProjects, skills } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const { showPhone, showSideProjects, photoTreatment } = settings.home;
---

<BaseLayout title="Ahmed Ghoneim — Senior Software Engineer">
  <div class="page">
    <SiteHeader current="home" />

    <main>
      <section class="hero container">
        <div>
          <p class="kicker">Hi, I'm</p>
          <h1 class="hero-title">Ahmed<br />Ghoneim</h1>
          <p class="hero-lede">
            Senior software engineer. Twelve years of building things people use every day, mostly
            on the frontend.
          </p>
          <div class="actions">
            <a href="/resume" class="btn btn-primary">Read the resume</a>
            <a href="/gallery" class="btn btn-ghost">See the gallery</a>
          </div>
        </div>
        <div>
          <img
            src="/assets/web/ahmed.jpg"
            alt="Ahmed Ghoneim"
            width="1050"
            height="1400"
            fetchpriority="high"
            class:list={['portrait', { warm: photoTreatment === 'warm' }]}
          />
          <p class="portrait-note">Currently a senior frontend engineer at Procore</p>
        </div>
      </section>

      <hr class="divider" />

      <section class="intro container">
        <h2 class="eyebrow">About me</h2>
        <div class="intro-body">
          <p>
            I'm a frontend-leaning full-stack developer. I write React and TypeScript every day, I'm
            genuinely fussy about CSS, and I'll go as deep into the backend as a feature needs — Go,
            Python, Node, Ruby, Kotlin, whatever the team runs on.
          </p>
          <p>
            Most of my favourite work is unglamorous: cutting an app's load time in half, getting an
            end-to-end suite reliable enough that people trust it, shaving fifteen minutes off how
            long an incident takes to mitigate. I've worked remotely for most of the last decade and
            I like it — it makes you write things down clearly.
          </p>
          <p>
            I also spend a lot of time mentoring, through 1:1s, sessions and code review. It's the
            part of the job I'd keep if I had to pick one.
          </p>
          <ul class="chips" aria-label="Skills">
            {skills.map((skill) => <li class="chip">{skill}</li>)}
          </ul>
        </div>
      </section>

      <hr class="divider" />

      <section class="section container">
        <div class="section-head">
          <h2 class="eyebrow">Where I've worked</h2>
          <a href="/resume">Full resume →</a>
        </div>
        <p class="statement roles-statement">Nine companies, two countries, twelve years.</p>
        <ul class="roles">
          {
            jobs.map((job) => (
              <li>
                <p class="role-company">{job.company}</p>
                <p class="role-title">{job.title}</p>
                <p class="role-years">{job.years}</p>
              </li>
            ))
          }
        </ul>
      </section>

      {
        showSideProjects && (
          <>
            <hr class="divider" />
            <section class="section container">
              <h2 class="eyebrow projects-label">Side projects</h2>
              <p class="projects-lede">Things I built for myself, in the open.</p>
              <div class="projects">
                {sideProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </section>
          </>
        )
      }

      <hr class="divider" />

      <section class="section container">
        <div class="section-head offclock-head">
          <h2 class="eyebrow">Off the clock</h2>
          <a href="/gallery">Everything in the gallery →</a>
        </div>
        <div class="offclock">
          <div class="offclock-body">
            <p class="statement">Mornings on foot, evenings in the kitchen.</p>
            <p>
              I take a walk most mornings and end up at the sea whenever I can. I cook — properly,
              not as a chore — and I'll try any cuisine once. The rest of my free time goes to the
              electric guitar, Lego sets big enough to take a week, video games, and horror movies.
            </p>
            <p>I photograph whatever's beautiful and standing still: coastline, light, weather.</p>
          </div>
          <figure>
            <a href="/gallery">
              <img
                src="/assets/web/photo-sunset.jpg"
                alt="Sunset over the sea"
                width="1050"
                height="1400"
                loading="lazy"
                decoding="async"
                class="media"
              />
            </a>
            <figcaption class="caption">
              Sunrise at the beach. <a href="/gallery">More in the gallery</a>
            </figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer class="contact container">
      <h2 class="eyebrow">Get in touch</h2>
      <p class="contact-email">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
      <div class="link-row">
        <a href={contact.linkedin}>LinkedIn</a>
        <a href={contact.github}>GitHub</a>
        <a href={contact.resumePdf} download>Resume (PDF)</a>
        {showPhone && <a href={contact.phone.href}>{contact.phone.display}</a>}
        <span class="text-subtle">{contact.location}</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Hero */

  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: end;
    padding-block: clamp(48px, 9vw, 104px) clamp(40px, 7vw, 80px);
  }

  .kicker {
    margin: 0 0 22px;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 6.6rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .hero-lede {
    max-width: 30ch;
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .actions {
    margin-top: 34px;
  }

  .portrait {
    width: 100%;
    height: 500px;
    border-radius: 6px;
    object-fit: cover;
    object-position: 50% 22%;
  }

  @media (max-width: 450px) {
    .portrait {
      height: 400px;
    }
  }

  .portrait.warm {
    filter: saturate(0.9) sepia(0.16) contrast(1.04);
  }

  .portrait-note {
    margin: 20px 0 0;
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Shared section chrome */

  .section {
    padding-block: var(--section-space);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 40px;
  }

  .section-head a {
    font-family: var(--font-display);
    font-size: 15px;
  }

  /* Hello */

  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 64px);
    padding-block: var(--section-space);
  }

  .intro > .eyebrow {
    flex: 0 0 auto;
    width: 150px;
    padding-top: 8px;
  }

  .intro-body {
    flex: 1 1 320px;
    min-width: 0;
  }

  .intro-body p {
    max-width: 62ch;
    margin: 0 0 1.1em;
    color: var(--ink-body);
    font-size: clamp(1.05rem, 1.9vw, 1.3rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .intro-body p:last-of-type {
    margin-bottom: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  /* Where I've worked */

  .roles-statement {
    max-width: 34ch;
    margin: 0 0 44px;
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--rule);
    list-style: none;
  }

  .roles li {
    padding: 20px 18px 22px;
    background: var(--bg);
  }

  .role-company {
    margin: 0 0 6px;
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
  }

  .role-title {
    margin: 0 0 4px;
    color: var(--ink-muted);
    font-size: 14.5px;
    line-height: 1.4;
  }

  .role-years {
    margin: 0;
    color: var(--ink-subtle);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.05em;
  }

  /* Side projects */

  .projects-label {
    margin-bottom: 18px;
  }

  .projects-lede {
    max-width: 52ch;
    margin: 0 0 40px;
    color: var(--ink-body);
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    line-height: 1.6;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  /* Off the clock */

  .offclock-head {
    margin-bottom: 36px;
  }

  .offclock {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .offclock > * {
    min-width: 0;
  }

  .offclock-body .statement {
    margin: 0 0 24px;
  }

  .offclock-body p:not(.statement) {
    max-width: 46ch;
    margin: 0 0 1.1em;
    color: var(--ink-body);
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .offclock-body p:last-child {
    margin-bottom: 0;
  }

  figure {
    margin: 0;
  }

  figure > a {
    display: block;
  }

  figure .caption {
    margin-top: 12px;
  }

  /* Get in touch */

  .contact {
    padding-block: clamp(48px, 7vw, 80px) clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--rule);
  }

  .contact > .eyebrow {
    margin-bottom: 24px;
  }

  .contact-email {
    margin: 0 0 40px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .contact-email a {
    border-bottom: 2px solid var(--accent);
    color: var(--ink-strong);
  }

  .contact-email a:hover {
    color: var(--link-hover);
  }
</style>
