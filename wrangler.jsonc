{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    // Astro links to /resume, not /resume/ — serve that directly instead of redirecting.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "ahmedghoneim.online",
      "custom_domain": true,
    },
    {
      "pattern": "www.ahmedghoneim.online",
      "custom_domain": true,
    },
  ],
}
